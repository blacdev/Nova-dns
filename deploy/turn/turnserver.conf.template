# coturn for the Nova platform (spec Part 2, section 6). Rendered by render-config.sh
# from the environment; runs on its own host with a public address.
listening-port=3478
tls-listening-port=443
fingerprint
use-auth-secret
# The API signs with TURN_SHARED_SECRET. During a rotation list the previous one as
# well (coturn accepts every static-auth-secret line); remove it 6 hours later.
static-auth-secret=${TURN_SHARED_SECRET}
${TURN_PREVIOUS_SECRET_LINE}
# Behind 1:1 NAT: external-ip=PUBLIC/PRIVATE (TURN_EXTERNAL_IP); empty otherwise.
${TURN_EXTERNAL_IP_LINE}
realm=${TURN_HOST}
server-name=${TURN_HOST}
cert=/etc/coturn/fullchain.pem
pkey=/etc/coturn/privkey.pem
min-port=49152
max-port=65535
no-multicast-peers
no-cli
# Never relay into private/internal networks:
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=100.64.0.0-100.127.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=0.0.0.0-0.255.255.255
denied-peer-ip=::1
denied-peer-ip=fc00::-fdff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=fe80::-febf:ffff:ffff:ffff:ffff:ffff:ffff:ffff
user-quota=12
total-quota=1200
# Usage per session (the shipper reads these lines; usernames carry the studio id).
log-file=/var/log/coturn/turn.log
simple-log
verbose
new-log-timestamp
