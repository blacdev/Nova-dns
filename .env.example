# The Nova platform's settings. Copy to .env and fill in. Never commit .env.

# --- the domain ----------------------------------------------------------------
# Stations get <name>.ROOT_DOMAIN; the API is api.ROOT_DOMAIN, the dashboard app.ROOT_DOMAIN,
# TURN turn.ROOT_DOMAIN. This must match Nova's ROOT_DOMAIN (Nova's remote/config.json).
ROOT_DOMAIN=myradiohost.com
DASHBOARD_URL=https://app.myradiohost.com

# --- database --------------------------------------------------------------------
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://nova:change-me@postgres:5432/nova

# --- DNS (Cloudflare) ------------------------------------------------------------
# The free Cloudflare plan is enough. docs/cloudflare-setup.md shows, step by step, where
# to get these two values; ./setup.sh finds the zone id itself and tests the token.
# They can also be left empty here and set in the dashboard (Admin > Settings), as can
# SMTP_URL, MAIL_FROM, ACME_EMAIL, staging/production and CERT_WEEKLY_LIMIT: a value saved
# there wins over this file and takes effect without a restart.
DNS_PROVIDER=cloudflare
# A token made from Cloudflare's "Edit zone DNS" template, for ROOT_DOMAIN's zone only.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# --- certificates (Let's Encrypt) ------------------------------------------------
# Staging while testing; production: https://acme-v02.api.letsencrypt.org/directory
ACME_DIRECTORY_URL=https://acme-staging-v02.api.letsencrypt.org/directory
ACME_EMAIL=ops@myradiohost.com
# New certificates per registered domain per 7 days (Let's Encrypt's limit).
CERT_WEEKLY_LIMIT=50

# --- TURN (coturn, on its own host) ----------------------------------------------
# Shared only between coturn and the API. During a rotation, put the old value in
# TURN_SHARED_SECRET_PREVIOUS on the coturn host for 6 hours, then remove it.
TURN_SHARED_SECRET=
TURN_SHARED_SECRET_PREVIOUS=
TURN_HOST=turn.myradiohost.com
# The coturn host's shipper uses this to report usage and fetch turn.ROOT_DOMAIN's certificate.
TURN_USAGE_TOKEN=
# (coturn host only) where the API is.
API_BASE=https://api.myradiohost.com

# --- the tunnel's edge (its own host; Nova's docs/TUNNEL.md) -----------------------
# Stations that open no port on their router dial the edge; presenters reach them there.
# Leave EDGE_IP empty to run no edge: stations are then only ever reached directly.
# On the platform (api, worker): the edge's public address, where stations' names point
# while they come in through it; and where stations dial (UDP), edge.ROOT_DOMAIN:443 by default.
EDGE_IP=
EDGE_HOST=
# The TCP port(s) presenters reach the edge on, told to stations. Behind a reverse proxy that
# keeps 443 (Nginx Proxy Manager), 25433 alone. Forward them straight to the edge, not
# through the proxy.
EDGE_PORTS=443,25433
# Shared only between the edge and the API: it checks stations and fetches edge.ROOT_DOMAIN's
# certificate with it (openssl rand -hex 32).
EDGE_TOKEN=
# (edge host only) where the API is.
EDGE_API_BASE=https://api.myradiohost.com

# --- dashboard -------------------------------------------------------------------
# Long and random (openssl rand -base64 48). Also encrypts TOTP secrets and the ACME key:
# changing it signs everyone out and turns off everyone's two-step sign-in.
SESSION_SECRET=
# Email for verification, resets and the admins' daily alert, e.g. smtps://user:pass@smtp.example.com:465
SMTP_URL=
MAIL_FROM=Nova <no-reply@myradiohost.com>
# The first account made is the super admin, who gives other accounts admin permissions
# in the dashboard. Optional: these become admins with every permission when they sign up.
ADMIN_EMAILS=
# Stations per person when no plan applies. Plans (Admin > Plans) and a person's own limit
# (on their page in Admin > People) replace this.
SUBDOMAIN_LIMIT=1

# --- network ---------------------------------------------------------------------
# X-Forwarded-For is believed only from these (Caddy in docker-compose.yml).
TRUSTED_PROXIES=172.28.0.10
API_PORT=8080
DASHBOARD_PORT=8081
